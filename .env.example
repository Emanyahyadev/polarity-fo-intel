# Copy to .env (gitignored) and fill in. All values have safe defaults except contact info.

# --- targets ---
TARGET_RECORDS=50
POOL_MULT=4.0

# --- HTTP / discovery ---
# SEC EDGAR and IRS ask for a descriptive User-Agent that includes real contact info.
USER_AGENT="PolarityFOIntel/0.1 (family-office intelligence assessment; contact: you@example.com)"
REQUEST_TIMEOUT=30
REQUEST_PAUSE=0.5

# --- email verification (validation layer) ---
SMTP_FROM="verify@yourdomain.com"
SMTP_TIMEOUT=10

# --- RAG (wired at Wave 3) — free-tier LLM for generation only ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- retrieval / grounding control ---
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.35

# --- storage ---
# Local/dev default is SQLite (DB_PATH). Set DATABASE_URL (Supabase/Postgres
# connection string) to switch the repository to Postgres at deploy — no code change.
DB_PATH=data/fointel.db
# DATABASE_URL=postgresql://user:pass@host:5432/postgres

# --- observability ---
LOG_DIR=logs

# --- paths ---
DATA_DIR=data

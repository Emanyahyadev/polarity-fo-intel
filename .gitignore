# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets & local config
.env

# Regenerable / bulky / third-party raw payloads (rebuilt by the pipeline)
data/raw/
data/interim/
# working databases (contain PII; regenerable by the pipeline)
data/*.db
data/*.db-wal
data/*.db-shm

# runtime run-traces / operating-cycle artifacts (regenerated every run)
logs/
# ...except the customer-facing agent's goal-run traces — these ARE a deliverable
# (raw, unedited run log per goal) and must stay in git, not be silently excluded.
!logs/agent/
!logs/agent/*.jsonl

# Model / embedding caches
.cache/
*.log
# precomputed doc vectors are a build artifact (regenerated in the image from the CSV)
data/final/doc_embeddings.np*

# OS
.DS_Store
Thumbs.db
